<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitleMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📖 Game Sambung Ayat"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnBukaLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitleMenu"
        android:text="🏆 Lihat Leaderboard Global"
        android:backgroundTint="#D84315"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <ListView
        android:id="@+id/lvSurah"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnBukaLeaderboard"
        android:divider="#BDC3C7"
        android:dividerHeight="1dp"/>

</RelativeLayout>