<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F7FA">

    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvSurahInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surah: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tvNyawa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="❤️ Nyawa: 3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E91E63"/>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvSurahInfo"
            android:layout_marginTop="5dp"
            android:text="Skor: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutPertanyaan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="25dp">

        <ImageButton
            android:id="@+id/btnPutarSuara"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Putar Suara" />

        <TextView
            android:id="@+id/tvPetunjuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dengarkan audio lalu susun potongan ayat di bawah!"
            android:textSize="13sp"
            android:textColor="#7F8C8D"
            android:layout_marginTop="5dp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvHasilSusunan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:text=""
            android:hint="[ Ketuk kata di bawah untuk menyusun ]"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:textColor="#2C3E50"
            android:elevation="3dp"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollPilihan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutPertanyaan"
        android:layout_above="@id/layoutAksiBawah"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutPilihanKata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="5dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutAksiBawah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 Bantuan (Hint)"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMenyerah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏳️ Menyerah"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E74C3C"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</RelativeLayout>